# CineRAG environment. Copy to `.env` and fill in. Never commit `.env`.
# Every variable here is read by core/config.py — nothing reads os.environ directly.

# ─── OpenAI (chat + embeddings) ────────────────────────────────────────────────
# The only paid dependency. Needed from Day 2 (embeddings) onward.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ─── TMDB (ingestion only) ─────────────────────────────────────────────────────
# Needed on Day 1. Get one free at https://www.themoviedb.org/settings/api
# Use the "API Read Access Token" (v4, a long JWT) if you have it — the pull sends
# it as a Bearer token. A v3 API key also works and is sent as a query param.
TMDB_API_KEY=

# ─── Qdrant (vector store) ─────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=movies

# ─── Neo4j (graph store) ───────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cinerag_dev_password

# ─── LangSmith (tracing + eval) ────────────────────────────────────────────────
# Wired from Day 3. Leave LANGCHAIN_TRACING_V2=false until then.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cinerag
LANGCHAIN_TRACING_V2=false

# ─── Ingestion ─────────────────────────────────────────────────────────────────
# Target movie count for the TMDB snapshot.
CATALOG_SIZE=5000

# ─── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
# LOG_JSON:  false = human-readable console (dev), true = JSON lines (prod/eval)
LOG_LEVEL=INFO
LOG_JSON=false
